{
  "name": "@certicraft/logging",
  "version": "1.2.1",
  "description": "This package is used to log and debug data to Google Cloud Platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [],
  "author": "CertiCraft",
  "license": "UNLICENSED",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "rm -rf tsconfig.tsbuildinfo && rm -rf dist && tsc --build",
    "test": "vitest",
    "prepublish": "tsc --build",
    "prepack": "npmignore",
    "coverage": "vitest run --coverage",
    "typeCheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/logging": "^11.0.0",
    "@google-cloud/logging-bunyan": "^5.0.0",
    "bunyan": "^1.8.15",
    "bunyan-format": "^0.2.1",
    "pino": "^9.4.0",
    "pino-cloud-logging": "^1.0.6",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bunyan": "^1.8.9",
    "@types/bunyan-format": "^0.2.6",
    "@vitest/coverage-c8": "^0.33.0",
    "npmignore": "^0.3.0",
    "typescript": "^5.2.2",
    "vite": "^4.4.9",
    "vitest": "^0.34.4"
  }
}
